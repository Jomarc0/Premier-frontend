{
  "expo": {
    "name": "Premier",
    "slug": "Premier",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/image/logo.png",
    "scheme": "premier",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.togi012322.premier",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/image/logo.png",
        "backgroundColor": "#E6F4FE"
      }
    },
    "ios": {
      "bundleIdentifier": "com.togi012322.premier",
      "supportsTablet": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/image/logo.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/image/logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#E6F4FE"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-local-authentication",
      "expo-font"
    ],
    "extra": {
      "apiUrl": "https://premiertranspo.onrender.com",
      "authBaseUrl": "https://premiertranspo.onrender.com",
      "eas": {
        "projectId": "0471fbd5-e9a9-479e-9864-2918c73262e3"
      }
    },
    "owner": "togi012322",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0471fbd5-e9a9-479e-9864-2918c73262e3"
    }
  }
}
